# Copie este arquivo para ".env" (na raiz do repositório) e preencha com
# valores reais. O ".env" NUNCA deve ser commitado (já está no .gitignore).
# Ver README.md, seção "Configuração (.env)", para detalhes de cada uma.

# --- Obrigatórias ---

# E-mail exigido pela API Entrez do NCBI (usado só como fallback quando
# uma sequência não está no manifesto local de taxonomia).
ENTREZ_EMAIL=seu-email@exemplo.com

# Conta de e-mail (e senha/senha de app) que envia a notificação de
# "relatório pronto" pro pesquisador.
EMAIL_REMETENTE=remetente@exemplo.com
EMAIL_SENHA=senha-ou-senha-de-app

# Token do GitHub com permissão de leitura/escrita em Issues do
# repositório. Só é obrigatório para src/main_issues.py (canal de
# submissão via GitHub Issues); src/main.py (canal Google Sheets) não usa.
GITHUB_TOKEN=ghp_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# --- Opcionais (têm default no código) ---

SMTP_SERVER=smtp.gmail.com
SMTP_PORT=587

# ATENÇÃO: os defaults built-in de GITHUB_REPO_NAME diferem entre
# main.py ("pipeline_genoma") e main_issues.py ("TerraSeq") quando essa
# variável não está definida. Defina explicitamente aqui para os dois
# processos usarem o mesmo valor.
GITHUB_REPO_OWNER=TerraSeq
GITHUB_REPO_NAME=TerraSeq

# Caminho do JSON de credenciais da service account do Google (Sheets +
# Drive), relativo a src/ se não for absoluto. Usado só por main.py.
GOOGLE_CREDENTIALS_PATH=credentials.json

# Nome da planilha Google Sheets consultada por main.py.
NOME_DA_PLANILHA=Submissoes_Primers_Pipeline

# Pasta onde ficam os bancos BLAST indexados. No servidor de produção
# aponta pro caminho fixo dentro do projeto; normalmente não precisa
# sobrescrever.
# DIRETORIO_BLAST=/caminho/para/data/blast_dbs

# Pasta com os binários blastn/makeblastdb/blastdbcmd corretos.
# IMPORTANTE: no servidor de produção existem DUAS instalações de BLAST+
# (uma 2.12.0 em /usr/bin, com bugs conhecidos, e uma 2.17.0 dedicada).
# Sempre aponte para a 2.17.0 — nunca deixe isso resolver via PATH.
# CAMINHO_BLAST_BIN=/home/othin/blast-latest/bin
